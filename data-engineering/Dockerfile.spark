# Spark Structured Streaming runtime.
#
# The official Spark image already carries a matching JVM and Scala build, which
# is what makes the Kafka connector version pin in docker-compose.yml valid.
# Installing Spark on top of a plain Python image instead would mean owning that
# compatibility matrix by hand.

FROM apache/spark:4.0.0-python3

USER root

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/citypulse/data-engineering

# Only what the job's own code needs. PySpark ships with the image, so
# installing it again from requirements.txt would shadow the version the JVM
# side expects — a mismatch that surfaces as an obscure serialisation error at
# the first micro-batch rather than at install time.
RUN pip install --no-cache-dir "psycopg[binary]==3.2.3" "kafka-python==2.0.2" "pyyaml>=6.0"

COPY common/ ./common/
COPY pipeline/ ./pipeline/
COPY generator/ ./generator/

# Connector jars, baked in rather than resolved at run time.
#
# `spark-submit --packages` downloads through Ivy into $HOME/.ivy2. The upstream
# image runs as user 185 whose home is /nonexistent, so the container died at
# startup with FileNotFoundException on the Ivy cache — found the first time the
# whole stack was brought up in CI.
#
# Baking them in also removes a network fetch from every container start, which
# is a second reason to prefer it: a Maven Central hiccup should not stop the
# pipeline.
#
# Versions are pinned together on purpose. The Scala suffix must match the Spark
# build (2.13 for Spark 4.x), and hadoop-aws must match the Hadoop that Spark
# links against, or the failure is a NoSuchMethodError at first use rather than
# a resolution error at startup.
#
# spark-hadoop-cloud is here for the two committer classes spark-defaults.conf
# names, and it is the one jar whose absence does not wait to be noticed: Spark
# validates those class names while building the session, so the job died before
# reading a single event, reporting an invalid config key rather than a missing
# jar. Everything else in this list fails at first use; this one fails at start.
RUN mkdir -p /opt/spark/jars \
    && cd /opt/spark/jars \
    && curl -fsSLO https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.4.1/hadoop-aws-3.4.1.jar \
    && curl -fsSLO https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/2.24.6/bundle-2.24.6.jar \
    && curl -fsSLO https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.13/4.0.0/spark-sql-kafka-0-10_2.13-4.0.0.jar \
    && curl -fsSLO https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.13/4.0.0/spark-token-provider-kafka-0-10_2.13-4.0.0.jar \
    && curl -fsSLO https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.9.0/kafka-clients-3.9.0.jar \
    && curl -fsSLO https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.12.0/commons-pool2-2.12.0.jar \
    && curl -fsSLO https://repo1.maven.org/maven2/org/apache/spark/spark-hadoop-cloud_2.13/4.0.0/spark-hadoop-cloud_2.13-4.0.0.jar

COPY docker/spark-defaults.conf /opt/spark/conf/spark-defaults.conf

RUN chown -R 185:185 /opt/citypulse

# The streaming checkpoint directory, created here so that it exists in the image
# before compose mounts a named volume over it.
#
# Docker seeds a fresh named volume from whatever is at the mount point in the
# image, ownership included — but when nothing is there it creates the directory
# itself, root-owned. The job then runs as 185 and cannot mkdir inside it, and
# Structured Streaming fails while resolving the checkpoint location, before any
# query starts. Creating it owned by 185 is what makes the volume come up
# writable.
RUN mkdir -p /tmp/citypulse-spark-checkpoint && chown 185:185 /tmp/citypulse-spark-checkpoint

# 185 is the spark user in the upstream image.
USER 185

ENV PYTHONPATH=/opt/citypulse/data-engineering
