# =============================================================================
# CityPulse OS — environment template
#
# Copy to .env and fill in real values. .env is git-ignored and must stay that
# way (docs/SECURITY.md §1).
#
#   cp .env.example .env
#
# Generate the secrets rather than inventing them:
#   CITYPULSE_JWT_SECRET   openssl rand -base64 48
#   CITYPULSE_DB_PASSWORD  openssl rand -base64 24
# =============================================================================

# --- Database ---------------------------------------------------------------
CITYPULSE_DB_URL=jdbc:postgresql://localhost:5432/citypulse
CITYPULSE_DB_USER=citypulse
# Required. The application will not start without it.
CITYPULSE_DB_PASSWORD=

# --- Authentication ---------------------------------------------------------
# Required, minimum 32 bytes. There is no default: a missing value stops the
# application rather than letting it sign tokens with a guessable key.
CITYPULSE_JWT_SECRET=

# --- Application ------------------------------------------------------------
CITYPULSE_SERVER_PORT=8080
CITYPULSE_FRONTEND_URL=http://localhost:3000
CITYPULSE_CORS_ORIGINS=http://localhost:3000
CITYPULSE_LOG_LEVEL=INFO

# true when city telemetry is synthetic. The UI labels demo data as such;
# never set this to false while still serving generated data.
CITYPULSE_DEMO_MODE=true

# Requires a configured mail provider. Leave false locally — no provider is
# wired up, and verification links are written to the application log instead.
CITYPULSE_REQUIRE_EMAIL_VERIFICATION=false

# --- First administrator ----------------------------------------------------
# Optional. When both email and password are set, a SUPER_ADMIN is created on
# startup if no account with that address exists. Leaving these blank creates
# nothing; the platform ships with no default administrator.
# The password must satisfy the policy: 12+ chars with upper, lower, digit, symbol.
CITYPULSE_BOOTSTRAP_ADMIN_EMAIL=
CITYPULSE_BOOTSTRAP_ADMIN_PASSWORD=
CITYPULSE_BOOTSTRAP_ADMIN_NAME="Platform Administrator"

# --- Docker Compose ---------------------------------------------------------
# Consumed by the postgres container. Keep POSTGRES_PASSWORD identical to
# CITYPULSE_DB_PASSWORD or the backend will not be able to connect.
POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=

# Host port the compose database publishes on. Change it if PostgreSQL is
# already running natively on 5432 — containers reach each other on 5432
# whatever this is set to.
POSTGRES_HOST_PORT=5432

# --- Frontend ---------------------------------------------------------------
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# =============================================================================
# Data platform
#
# Only needed for the `streaming` and `orchestration` compose profiles. The core
# stack (postgres, backend, frontend) starts without any of these.
# =============================================================================

# --- Data platform database access ------------------------------------------
# libpq URL used by the generator, pipeline runner and dbt. The tools also
# accept the JDBC form above and strip the prefix, so this is only needed when
# the two differ.
# CITYPULSE_PG_DSN=postgresql://citypulse:PASSWORD@localhost:5432/citypulse

# --- Kafka (profile: streaming) ---------------------------------------------
# Inside compose the brokers are reachable as kafka:9092. From the host, the
# EXTERNAL listener is published on 29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- MinIO (profile: streaming) ---------------------------------------------
# Object storage for the data lake. Required by the minio service — compose
# fails to start rather than booting with the vendor's well-known defaults.
#   MINIO_ROOT_PASSWORD  openssl rand -base64 24
MINIO_ROOT_USER=citypulse
MINIO_ROOT_PASSWORD=

# --- Airflow (profile: orchestration) ---------------------------------------
# Encrypts connection credentials in Airflow's metadata database. Losing it
# makes stored connections unreadable, so keep it stable across restarts.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Signs Airflow session cookies.
#   openssl rand -base64 32
AIRFLOW_SECRET_KEY=

# Web UI login, published on http://localhost:8081.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Fails the historical-ingestion DAG when the share of valid records in a
# backfill falls below this. A run that quietly loaded 40% of its data is worse
# than one that failed.
CITYPULSE_MIN_VALIDITY_RATIO=0.98

# Fails the daily analytics DAG when the newest curated window is older than
# this, so stale marts are reported rather than served.
CITYPULSE_MAX_STALENESS_HOURS=6
